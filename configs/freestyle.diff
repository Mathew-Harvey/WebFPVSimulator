# diff
# Betaflight / SITL (SITL) 4.5.1
#
# The default flying config for the shell. This is NOT the verification
# fixture: tests/fixtures/config-baseline.diff is owned by the harness and
# must not change. This file is the one a pilot actually flies, and it is
# meant to be edited, or replaced by dropping your own diff on the page.
#
# Rates: ACTUAL, 700 deg/s max on roll and pitch, 650 on yaw, 140 deg/s
# centre sensitivity, 0.30 expo. Real freestyle rates.
#
# Tune: stock Betaflight 4.5.1 defaults. The previous file carried a
# custom tune that a grid search fitted to a plant later shown to violate
# momentum theory; a pilot review read that as the diagnostic it was. On
# the rebuilt plant the stock tune flies clean, which is the test that the
# plant is right. Rates raised to a real freestyle 700 deg/s.

batch start

board_name SITL

# master
set gyro_lpf1_static_hz = 250
set gyro_lpf2_static_hz = 500
set dyn_notch_count = 0
set motor_kv = 1900
set motor_poles = 14
set vbat_max_cell_voltage = 420
set vbat_min_cell_voltage = 350
set vbat_warning_cell_voltage = 350
set battery_capacity = 1300
set yaw_motors_reversed = OFF
set small_angle = 180

# profile 0
profile 0

set p_roll = 45
set i_roll = 80
set d_roll = 40
set f_roll = 120
set p_pitch = 47
set i_pitch = 84
set d_pitch = 46
set f_pitch = 125
set p_yaw = 45
set i_yaw = 80
set d_yaw = 0
set f_yaw = 120

# rateprofile 0
rateprofile 0

set rates_type = ACTUAL
set roll_rc_rate = 14
set pitch_rc_rate = 14
set yaw_rc_rate = 14
set roll_expo = 30
set pitch_expo = 30
set yaw_expo = 30
set roll_srate = 70
set pitch_srate = 70
set yaw_srate = 65

batch end
