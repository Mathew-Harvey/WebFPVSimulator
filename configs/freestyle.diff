# diff
# Betaflight / SITL (SITL) 4.5.1
#
# The default flying config for the shell. This is NOT the verification
# fixture: tests/fixtures/config-baseline.diff is owned by the harness and
# must not change. This file is the one a pilot actually flies, and it is
# meant to be edited, or replaced by dropping your own diff on the page.
#
# Rates: ACTUAL, 500 deg/s max on roll and pitch, 450 on yaw, with 120
# deg/s of centre sensitivity and 0.55 expo. That is a controllable
# freestyle rate rather than the 670 deg/s race rate in the fixture, and
# the expo puts real resolution around centre stick where small corrections
# live.
#
# Tune: measured against this plant rather than copied from a real quad.
# Step response at 500 deg/s roll: 1.5 percent overshoot, 115 ms to 90
# percent, settles inside 135 ms, and 16 deg/s of reverse rate on stick
# release. The stock fixture tune on the same plant overshoots 17 percent
# and reverses 72 deg/s, which is the wallow and snap back a pilot feels.
# I is deliberately below a real world value because this airframe flies in
# still air with no prop imbalance, so a large integral term buys nothing
# and costs stick release behaviour. See PROGRESS.md.

batch start

board_name SITL

# master
set gyro_lpf1_static_hz = 250
set gyro_lpf2_static_hz = 500
set dyn_notch_count = 0
set motor_kv = 1900
set motor_poles = 14
set vbat_max_cell_voltage = 420
set vbat_min_cell_voltage = 350
set vbat_warning_cell_voltage = 350
set battery_capacity = 1300
set yaw_motors_reversed = OFF
set small_angle = 180

# profile 0
profile 0

set p_roll = 60
set i_roll = 40
set d_roll = 38
set f_roll = 120
set p_pitch = 62
set i_pitch = 42
set d_pitch = 40
set f_pitch = 125
set p_yaw = 55
set i_yaw = 40
set d_yaw = 0
set f_yaw = 120

# rateprofile 0
rateprofile 0

set rates_type = ACTUAL
set roll_rc_rate = 12
set pitch_rc_rate = 12
set yaw_rc_rate = 12
set roll_expo = 55
set pitch_expo = 55
set yaw_expo = 50
set roll_srate = 50
set pitch_srate = 50
set yaw_srate = 45

batch end
