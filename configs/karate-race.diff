# diff
# Betaflight / SITL (SITL) 4.5.1
#
# KARATE RACE, 6S 5 INCH. The tune sugarK (Zak Smiley) developed with
# ctzsnooze around KarateBrot's RPM crossfade work, flown on the Viper
# racer and limon's OpenRacer, and the tune behind the 2021 MultiGP
# International Open. It is the reference aggressive race tune for a 6S
# 5 inch and it is what this simulator's reference airframe is.
#
# NO RATES. sugarK offers his own racing rates alongside this tune and they
# were shipped inside it, which was a mistake: switching to Karate then
# changed the tune AND took the stick from 670 to 420 deg/s with 0.54 expo in
# one keypress, so the tune could never be judged on its own and the owner
# correctly reported it felt worse. Rates are chosen in Settings now and
# appended to whichever tune is loaded; see configs/rates.js. To fly sugarK's
# rates, set 420 max and 0.55 expo in the menu.
#
# PROVENANCE. Flattened, in the order Betaflight's own preset system
# flattens it, from betaflight/firmware-presets at 4.5:
#   presets/4.5/tune/defaults.txt          the 4.5 tune baseline
#   presets/4.5/filters/defaults.txt       the 4.5 filter baseline
#   presets/4.5/tune/karate/karate_race.txt   the tune itself, with only
#       its CHECKED option (DShot600) taken and every UNCHECKED option
#       (Bosch gyro, dynamic idle, Old Spice, New Spice) left out
#   presets/4.3/rc_link/generic/250hz_race.txt   the feedforward and rc
#       smoothing settings for a 250 Hz link, which is the rate the shell
#       samples sticks at (src/main.js RC_HZ)
#
# `simplified_tuning apply` below is a real CLI command and this simulator
# runs Betaflight's own config/simplified_tuning.c on it. The sliders
# above it produce roll P38 I81 D35 Dmax21 F126 and pitch P41 I89 D40
# Dmax23 F137, and the lines below it override what they are meant to.
#
# WHAT THIS SIMULATOR CANNOT GIVE THE TUNE, stated plainly because half of
# a race tune is its filter tune:
#
#   * RPM filtering does nothing here. The tune's warning that you must
#     run it is about motor and frame resonance putting heat into the
#     motors. This model has a perfectly smooth gyro, so there is no
#     resonance to notch out, and USE_RPM_FILTER is not built for the
#     SITL target anyway.
#   * Dynamic notches do nothing, for the same reason, and Betaflight
#     itself undefines USE_DYN_NOTCH_FILTER on any SIMULATOR_BUILD
#     because the FFT wants CMSIS arm_math.h.
#   * The gyro lowpass settings DO matter and are live: lpf1 dynamic
#     500 to 1000 Hz against the default 250 to 500 Hz is real phase
#     lead, and it is compiled Betaflight code applying it.
#
# The PID, feedforward, TPA, iterm relax, throttle boost, pidsum limit,
# D max, rates and rc smoothing halves of this tune are all live.

batch start

board_name SITL

# ---- airframe, read by the plant ----
set motor_kv = 1900
set motor_poles = 14
set vbat_max_cell_voltage = 420
set vbat_min_cell_voltage = 350
set vbat_warning_cell_voltage = 350
set battery_capacity = 1300
set small_angle = 180

# ---- presets/4.5/filters/defaults.txt ----
set gyro_hardware_lpf = NORMAL
set gyro_lpf1_type = PT1
set gyro_lpf1_static_hz = 250
set gyro_lpf2_type = PT1
set gyro_lpf2_static_hz = 500
set gyro_notch1_hz = 0
set gyro_notch1_cutoff = 0
set gyro_notch2_hz = 0
set gyro_notch2_cutoff = 0
set gyro_lpf1_dyn_min_hz = 250
set gyro_lpf1_dyn_max_hz = 500
set gyro_lpf1_dyn_expo = 5
set gyro_filter_debug_axis = ROLL
set dshot_bidir = OFF
set simplified_gyro_filter = ON
set simplified_gyro_filter_multiplier = 100

# ---- presets/4.5/tune/defaults.txt, master half ----
set yaw_spin_recovery = AUTO
set dshot_idle_value = 550
set mixer_type = LEGACY
set yaw_motors_reversed = OFF

# ---- karate_race.txt, gyro lowpass filters ----
set gyro_lpf1_static_hz = 0
set gyro_lpf1_dyn_min_hz = 500
set gyro_lpf1_dyn_max_hz = 1000
set simplified_gyro_filter = OFF

# ---- karate_race.txt, gyro dynamic notches ----
set dyn_notch_count = 2
set dyn_notch_q = 450
set dyn_notch_min_hz = 125
set dyn_notch_max_hz = 650

# ---- karate_race.txt, RPM filtering, and the checked DShot600 option ----
set dshot_bidir = ON
set rpm_filter_fade_range_hz = 100
set motor_pwm_protocol = DSHOT600

# ---- profile 0 ----
profile 0

# presets/4.5/tune/defaults.txt, profile half
set pid_at_min_throttle = ON
set anti_gravity_gain = 80
set anti_gravity_cutoff_hz = 5
set anti_gravity_p_gain = 100
set acc_limit_yaw = 0
set acc_limit = 0
set iterm_rotation = OFF
set iterm_relax = RP
set iterm_relax_type = SETPOINT
set iterm_relax_cutoff = 15
set iterm_windup = 85
set iterm_limit = 400
set pidsum_limit = 500
set pidsum_limit_yaw = 400
set throttle_boost = 5
set throttle_boost_cutoff = 15
set p_roll = 45
set i_roll = 80
set d_roll = 40
set f_roll = 120
set p_pitch = 47
set i_pitch = 84
set d_pitch = 46
set f_pitch = 125
set p_yaw = 45
set i_yaw = 80
set d_yaw = 0
set f_yaw = 120
set d_min_roll = 30
set d_min_pitch = 34
set d_min_yaw = 0
set d_max_gain = 37
set d_max_advance = 20
set abs_control_gain = 0
set use_integrated_yaw = OFF
set thrust_linear = 0
set transient_throttle_limit = 0
set feedforward_transition = 0
set feedforward_max_rate_limit = 90
set dyn_idle_min_rpm = 0
set tpa_mode = D
set tpa_rate = 65
set tpa_breakpoint = 1350
set tpa_low_rate = 20
set tpa_low_breakpoint = 1050
set tpa_low_always = OFF
set ez_landing_threshold = 25
set ez_landing_limit = 5

# presets/4.5/filters/defaults.txt, profile half
set dterm_lpf1_dyn_min_hz = 75
set dterm_lpf1_dyn_max_hz = 150
set dterm_lpf1_dyn_expo = 5
set dterm_lpf1_type = PT1
set dterm_lpf1_static_hz = 75
set dterm_lpf2_type = PT1
set dterm_lpf2_static_hz = 150
set dterm_notch_hz = 0
set dterm_notch_cutoff = 0
set yaw_lowpass_hz = 100
set simplified_dterm_filter = ON
set simplified_dterm_filter_multiplier = 100

# ---- karate_race.txt, D term filtering ----
set dterm_lpf1_dyn_expo = 7

# ---- karate_race.txt, misc ----
set thrust_linear = 0
set throttle_boost = 2

# ---- karate_race.txt, I term ----
set iterm_relax_cutoff = 45

# ---- karate_race.txt, PID sum limits ----
set iterm_limit = 500
set pidsum_limit_yaw = 1000

# ---- karate_race.txt, PID values through the sliders ----
set simplified_pids_mode = RP
set simplified_i_gain = 120
set simplified_d_gain = 70
set simplified_pi_gain = 85
set simplified_dmax_gain = 200
set simplified_feedforward_gain = 105
set simplified_pitch_pi_gain = 105
simplified_tuning apply

# ---- karate_race.txt, feedforward ----
set feedforward_max_rate_limit = 100

# ---- karate_race.txt, TPA ----
set tpa_rate = 70
set tpa_breakpoint = 1250

# ---- presets/4.3/rc_link/generic/250hz_race.txt ----
set feedforward_averaging = 2_POINT
set feedforward_smooth_factor = 35
set feedforward_jitter_factor = 4
set feedforward_boost = 18
set rc_smoothing_auto_factor = 25
set rc_smoothing_auto_factor_throttle = 25

batch end
