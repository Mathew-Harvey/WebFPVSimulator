batch start

board_name SITL

# ---- airframe, read by the plant and by the RPM filter ----
#
# 30000 kV is the plate. The PLANT does not change between the three
# variants: src/native/plant.c models the Champion, and the difference the
# other two make in the real world is a few percent of top end and a
# different feel at the bottom of the stick, which is carried here by the
# tune rather than by a second set of motor constants. That is an honest
# simplification and it is written down rather than hidden: see PROGRESS.md.
# 12 poles is a 9N12P 0702.
set motor_kv = 30000
set motor_poles = 12
# 1S LiHV: 4.40 V charged, 3.45 V warning, 3.00 V empty. The Champion's own
# battery profile.
set vbat_max_cell_voltage = 440
set vbat_warning_cell_voltage = 345
set vbat_min_cell_voltage = 300
set battery_capacity = 300
set small_angle = 180

# ---- master, from the factory dump ----
set gyro_lpf1_static_hz = 0
set gyro_lpf1_dyn_min_hz = 0
set gyro_lpf1_dyn_max_hz = 550
set gyro_lpf2_static_hz = 600
set gyro_lpf1_type = PT1
set gyro_lpf2_type = PT1
set gyro_notch1_hz = 0
set gyro_notch1_cutoff = 0
set gyro_notch2_hz = 0
set gyro_notch2_cutoff = 0
set dyn_notch_count = 1
set dyn_notch_q = 400
set dyn_notch_min_hz = 110
set dyn_notch_max_hz = 500
set simplified_gyro_filter = ON
set simplified_gyro_filter_multiplier = 120
set dshot_bidir = ON
set motor_pwm_protocol = DSHOT300
set mixer_type = LEGACY
set yaw_spin_recovery = AUTO
#
# yaw_motors_reversed stays OFF, and the factory dump has it ON.
#
# That is not a tuning choice, it is a wiring one, and copying it here would
# be a bug. The Air65 II is built props out, so its ESC outputs run the
# opposite way round from a props in machine and the firmware is told to
# flip the yaw mixer column to match. This simulator's plant has ONE spin
# table, PLANT_SPIN in src/native/plant.c, and it is props in. Carrying the
# factory ON with a props in plant negates the yaw column against a rotation
# that did not change, which turns the yaw loop into positive feedback: the
# nose runs away from any yaw input instead of following it. The comment at
# PLANT_SPIN traces the whole sign chain and this is the link it warns about.
set yaw_motors_reversed = OFF

# ---- THE 4.6 D TERM KEYS ARE INVERTED AGAINST 4.5, AND THAT IS A TRAP ----
#
# BetaFPV's dump is Betaflight 2026.6.0. Somewhere between 4.5 and 4.6 the
# D term pair changed which end of the range each key names:
#
#   4.5.1   d_roll     is the D CEILING, d_min_roll is the FLOOR
#   4.6+    d_roll     is the D FLOOR,   d_max_roll is the CEILING
#
# The vendored 4.5.1 tree is the authority for the first line
# (vendor/betaflight/src/main/cli/settings.c:1159 and :1191, where d_roll
# writes pid[PID_ROLL].D and d_min_roll writes d_min[FD_ROLL]). The factory
# dump carries BOTH d_roll and d_max_roll, which 4.5 has no name for, so the
# translation swaps them. Copying the dump's d_roll straight across would
# have set the CEILING to the FLOOR and quietly deleted the whole D boost
# band on every one of these three tunes.
#
# Two more names moved with it: 4.6's simplified_d_max_gain is 4.5.1's
# simplified_dmax_gain (fc/parameter_names.h:116), and 4.5.1's d_max_gain
# writes the field called d_min_gain (settings.c:1194), which is the boost
# gain rather than a ceiling and needed no translation.

# ---- profile 0, from the factory dump ----
profile 0

set profile_name = GF 1207
set p_roll = 38
set i_roll = 54
set d_roll = 29
set f_roll = 45
set p_pitch = 39
set i_pitch = 57
set d_pitch = 31
set f_pitch = 47
set p_yaw = 38
set i_yaw = 54
set d_yaw = 0
set f_yaw = 45
set d_min_roll = 26
set d_min_pitch = 28
set d_min_yaw = 0
set d_max_gain = 20
set anti_gravity_gain = 60
set throttle_boost = 0
set feedforward_jitter_factor = 5
set dyn_idle_min_rpm = 30
set tpa_mode = D
set tpa_rate = 60
set tpa_breakpoint = 1210
set auto_profile_cell_count = 1
set simplified_master_multiplier = 85
set simplified_i_gain = 80
set simplified_d_gain = 105
set simplified_dmax_gain = 25
set simplified_feedforward_gain = 45
set simplified_pitch_d_gain = 95

# ---- what the factory dump does NOT carry, and is left at 4.5.1 default ----
#
# iterm_relax RP / SETPOINT / cutoff 15, pidsum limits 500 and 400,
# anti_gravity_cutoff_hz 5, thrust_linear 0, vbat_sag_compensation 0, and
# the whole D term filter block. A Betaflight diff prints only what differs
# from default, so every one of those is BetaFPV agreeing with Betaflight,
# and this file agrees with both by staying quiet.
#
# vbat_sag_compensation is the one worth naming. It is 0 here because the
# factory dump leaves it at 0, and on 1S that is a real choice rather than
# an oversight: with 100 the D term is scaled up as the pack sags, which on
# a whoop is most of the throttle range and most of the flight. BetaFPV's
# Meteor65 Pro DOES ship 100. Both aircraft are theirs, so this is a genuine
# split in their own line, and the Champion's answer is the one this file
# carries because this file is the Champion's tune.

# ---- what is left out on purpose ----
#
#   align_board_yaw -135, acc_calibration, vbat_scale 113, ibata_offset:
#     properties of one physical board's mounting and its shunt, meaningless
#     against a simulated gyro and a solved pack.
#   the OSD block, vtxtable, vtx_*, vcd_video_system, beacon, aux, craft_name:
#     nothing in this simulator renders an OSD or a video transmitter.
#   dshot_bitbang AUTO: an MCU peripheral choice.
#   the throttle curve keys, which belong to
#     the rate profile and therefore to the pilot, same rule as rates.
