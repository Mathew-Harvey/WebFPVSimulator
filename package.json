{
  "name": "webfpvsimulator",
  "version": "0.1.0",
  "description": "Browser FPV racing simulator. Stage 1: flight physics and its verification harness.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "node tests/verify.js",
    "build:wasm": "node scripts/run-bash.js scripts/build-wasm.sh",
    "gen:baseline": "node tests/gen/gen-baseline.js",
    "serve": "node scripts/serve.js",
    "gates": "node scripts/gates.js",
    "lint:presets": "node scripts/preset-lint.js",
    "lint:catalog": "node scripts/fc-catalog-lint.js",
    "lint:shell": "node scripts/shell-check.js",
    "lint:fc": "node scripts/fc-trace.js",
    "gen:catalog": "node scripts/fc-catalog-gen.js",
    "gen:music": "node scripts/music.js",
    "gen:icons": "node scripts/icons.js sakura . && node scripts/icons.js amber src/trackbuilder",
    "gen:og": "node scripts/og.js .",
    "ghost:selftest": "node scripts/ghost-selftest.js",
    "contact:selftest": "node scripts/contact-selftest.js",
    "replay:selftest": "node scripts/replay-log.js --selftest",
    "replay": "node scripts/replay-log.js",
    "link:selftest": "node scripts/link-selftest.js",
    "test:edge": "node edge/selftest.js"
  }
}
