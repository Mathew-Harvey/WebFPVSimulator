    "music:selftest": "node scripts/music-selftest.js",
    "test:edge": "node edge/selftest.js",
    "lint:nouns": "node scripts/noun-lint.js",
    "lint:devices": "node scripts/device-check.js",
    "lint:arcade": "node scripts/arcade-check.js",
    "lint:responsive": "node scripts/responsive-check.js",
    "lint:board": "node scripts/board-check.js",
    "lint:attract": "node scripts/attract-check.js",
    "park:fly": "node scripts/park-fly.js",
    "trick:sweep": "node scripts/trick-sweep.js"
