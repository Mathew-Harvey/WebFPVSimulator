# diff
# Betaflight / SITL (SITL) 4.5.1
# fixture: baseline config for the Stage 1 reference airframe.
# Owned by Loop A. tests/fixtures/config-rates-b.diff must differ from this
# file only in the three srate lines, which check 12 relies on.

batch start

board_name SITL

# master
set gyro_lpf1_static_hz = 250
set gyro_lpf2_static_hz = 500
set dyn_notch_count = 0
set motor_kv = 1900
set motor_poles = 14
set vbat_max_cell_voltage = 420
set vbat_min_cell_voltage = 350
set vbat_warning_cell_voltage = 350
set battery_capacity = 1300
set yaw_motors_reversed = OFF
set small_angle = 180

# profile 0
profile 0

set p_roll = 45
set i_roll = 80
set d_roll = 40
set f_roll = 120
set p_pitch = 47
set i_pitch = 84
set d_pitch = 46
set f_pitch = 125
set p_yaw = 45
set i_yaw = 80
set d_yaw = 0
set f_yaw = 120

# rateprofile 0
rateprofile 0

set rates_type = ACTUAL
set roll_rc_rate = 18
set pitch_rc_rate = 18
set yaw_rc_rate = 18
set roll_expo = 54
set pitch_expo = 54
set yaw_expo = 54
set roll_srate = 67
set pitch_srate = 67
set yaw_srate = 67

batch end
